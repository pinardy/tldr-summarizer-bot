# Copy to .env and fill in.
# Telegram bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Your chat ID: message your bot once, then check
# https://api.telegram.org/bot<TOKEN>/getUpdates -> message.chat.id
TELEGRAM_CHAT_ID=

# Optional: LLM API key for AI key-points summarization. The default endpoint
# is Gemini's OpenAI-compatible API, so put a Gemini API key here
# (https://ai.google.dev — free tier is plenty for this workload).
# The OPENCODE_* names are historical; any OpenAI-compatible endpoint works.
# Leave empty to send the full parsed story list instead.
OPENCODE_API_KEY=

# Optional: model override (a model available on your endpoint).
#OPENCODE_MODEL=gemini-3.5-flash

# Optional: endpoint override (any OpenAI-compatible chat/completions URL),
# e.g. opencode Go: https://opencode.ai/zen/go/v1/chat/completions
#OPENCODE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
